# graftail 环境变量配置
# 将此文件复制为 .env 并填入实际值:
#   cp .env.example .env
#
# 加载顺序: .env (当前目录) > ~/.config/graftail/.env

GRAFTAIL_URL=https://grafana.do.top/
GRAFTAIL_DATASOURCE_UID=cfqnqnspcenswa
GRAFTAIL_USER=lm
GRAFTAIL_PASSWORD=qwer

# 可选:
# GRAFTAIL_QUERY='{service_name="prod-api"}'
# GRAFTAIL_TOKEN=           # 优先于用户名密码
